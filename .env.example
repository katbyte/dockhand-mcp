# copy to .env (gitignored) next to docker-compose.yml
# a Dockhand API token: web console -> Profile -> API tokens, for a user whose role is what the tools should be able to do
# leave it empty for a Dockhand that runs with its login switched off, which asks for none
DOCKHAND_TOKEN=
# bearer token clients must send to the MCP endpoint; e.g. openssl rand -hex 32
DOCKHAND_AUTH_TOKEN=

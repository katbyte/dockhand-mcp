      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostPruneVolumesAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],

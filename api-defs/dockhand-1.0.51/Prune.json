      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostPruneVolumesResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],

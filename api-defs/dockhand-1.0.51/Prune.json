{
  "Name": "Prune",
  "Tag": "prune",
  "Operations": [
    {
      "Name": "PostPruneAll",
      "OperationId": "post_api_prune_all",
      "Method": "POST",
      "Path": "/api/prune/all",
      "Description": "Prune all unused Docker resources (containers, images, volumes and networks) in a single operation",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Target environment id; scopes both the prune operation and the permission check (defaults to the local environment) (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostPruneAllAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostPruneContainers",
      "OperationId": "post_api_prune_containers",
      "Method": "POST",
      "Path": "/api/prune/containers",
      "Description": "Prune (delete) all stopped containers in the target environment",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Target environment id; scopes both the prune operation and the permission check (defaults to the local environment) (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostPruneContainersAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostPruneImages",
      "OperationId": "post_api_prune_images",
      "Method": "POST",
      "Path": "/api/prune/images",
      "Description": "Prune unused Docker images, streaming progress as a Server-Sent Events job",
      "Options": [
        {
          "Name": "dangling",
          "Field": "Dangling",
          "In": "Query",
          "Description": "When not \"false\", prune only dangling images; set \"dangling=false\" to prune all unused images (defaults to dangling-only)",
          "Type": {
            "Type": "Boolean"
          }
        },
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Target environment id; scopes both the prune operation and the permission check (defaults to the local environment) (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        },
        {
          "Name": "Accept",
          "Field": "Accept",
          "In": "Header",
          "Description": "what the caller will take for an answer. Left out, the call waits for the work and answers how it went; AcceptJob has it answered with the id of a job at once",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostPruneImagesAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostPruneNetworks",
      "OperationId": "post_api_prune_networks",
      "Method": "POST",
      "Path": "/api/prune/networks",
      "Description": "Prune (delete) all unused Docker networks in the target environment",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Target environment id; scopes both the prune operation and the permission check (defaults to the local environment) (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostPruneNetworksAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostPruneVolumes",
      "OperationId": "post_api_prune_volumes",
      "Method": "POST",
      "Path": "/api/prune/volumes",
      "Description": "Prune (delete) all unused Docker volumes in the target environment",

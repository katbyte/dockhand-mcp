    {
      "Name": "GetVolumesByNameBrowse",
      "OperationId": "get_api_volumes_name_browse",
      "Method": "GET",
      "Path": "/api/volumes/{name}/browse",
      "Description": "Browse a directory inside a Docker volume via a cached helper container; the volume is mounted read-only when in use by other containers",
      "PathParameters": [
        {
          "Name": "name",
          "Argument": "name",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Environment ID the volume belongs to (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "path",
          "Field": "Path",
          "In": "Query",
          "Description": "Directory path inside the volume to list (defaults to \"/\")",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetVolumesByNameBrowseResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

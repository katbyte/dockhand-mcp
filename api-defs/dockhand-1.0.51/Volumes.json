      "OperationId": "get_api_volumes_name_browse_content",
      "Method": "GET",
      "Path": "/api/volumes/{name}/browse/content",
      "Description": "Read the content of a single file inside a Docker volume (files larger than 1MB are rejected)",
      "PathParameters": [
        {
          "Name": "name",
          "Argument": "name",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "path",
          "Field": "Path",

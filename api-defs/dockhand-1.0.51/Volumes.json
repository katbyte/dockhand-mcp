    {
      "Name": "GetVolumesByNameExport",
      "OperationId": "get_api_volumes_name_export",
      "Method": "GET",
      "Path": "/api/volumes/{name}/export",
      "Description": "Export a Docker volume (or a sub-path) as a downloadable archive — streaming tar, gzip-compressed tar.gz, or raw single-file bytes",
      "PathParameters": [
        {
          "Name": "name",
          "Argument": "name",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Environment ID the volume belongs to (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "path",
          "Field": "Path",
          "In": "Query",
          "Description": "Sub-path inside the volume to export (defaults to \"/\")",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "format",
          "Field": "Format",
          "In": "Query",
          "Description": "Archive format: \"tar\" (default), \"tar.gz\", or \"raw\" (single file)",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/x-tar",
        "Type": {
          "Type": "RawFile"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

{
  "Name": "Volumes",
  "Tag": "volumes",
  "Operations": [
    {
      "Name": "DeleteVolumesByName",
      "OperationId": "delete_api_volumes_name",
      "Method": "DELETE",
      "Path": "/api/volumes/{name}",
      "Description": "Remove a Docker volume by name, optionally forcing removal",
      "PathParameters": [
        {
          "Name": "name",
          "Argument": "name",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Environment ID the volume belongs to (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "force",
          "Field": "Force",
          "In": "Query",
          "Description": "Force removal of the volume",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteVolumesByNameResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {

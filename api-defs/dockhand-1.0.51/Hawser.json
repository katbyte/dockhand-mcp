{
  "Name": "Hawser",
  "Tag": "hawser",
  "Operations": [
    {
      "Name": "DeleteHawserTokens",
      "OperationId": "delete_api_hawser_tokens",
      "Method": "DELETE",
      "Path": "/api/hawser/tokens",
      "Description": "Revoke a Hawser agent token by ID",
      "Options": [
        {
          "Name": "id",
          "Field": "Id",
          "In": "Query",
          "Description": "ID of the token to revoke (from GET /api/hawser/tokens)",
          "Required": true,
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteHawserTokensAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetHawserConnect",
      "OperationId": "get_api_hawser_connect",
      "Method": "GET",
      "Path": "/api/hawser/connect",
      "Description": "Report the Hawser Edge WebSocket endpoint status and list currently connected agents",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetHawserConnectAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetHawserTokens",
      "OperationId": "get_api_hawser_tokens",
      "Method": "GET",
      "Path": "/api/hawser/tokens",
      "Description": "List all Hawser agent tokens (only the prefix is returned, never the full token)",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "GetHawserTokensAnswer"
          }
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostHawserConnect",
      "OperationId": "post_api_hawser_connect",
      "Method": "POST",
      "Path": "/api/hawser/connect",
      "Description": "Fallback for non-WebSocket clients; always advises upgrading to a WebSocket connection",
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostHawserTokens",
      "OperationId": "post_api_hawser_tokens",
      "Method": "POST",
      "Path": "/api/hawser/tokens",
      "Description": "Generate a new Hawser agent token for an environment (the plaintext token is returned only once)",
      "Request": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostHawserTokensRequest"
        }
      },
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostHawserTokensAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],

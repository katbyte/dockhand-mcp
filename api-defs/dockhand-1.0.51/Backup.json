      "OperationId": "delete_api_backup_configs_id",
      "Method": "DELETE",
      "Path": "/api/backup/configs/{id}",
      "Description": "Delete a backup configuration and unregister its schedule, optionally forgetting its snapshots too",
      "PathParameters": [
        {
          "Name": "id",
          "Argument": "id",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Options": [
        {
          "Name": "deleteSnapshots",
          "Field": "DeleteSnapshots",
          "In": "Query",
          "Description": "Also forget and prune this config's snapshots (default false; snapshots survive so a restore is still possible)",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "DeleteBackupDestinationsById",
      "OperationId": "delete_api_backup_destinations_id",

      "OperationId": "delete_api_backup_snapshots_id",
      "Method": "DELETE",
      "Path": "/api/backup/snapshots/{id}",
      "Description": "Forget and prune a single snapshot from a destination (destructive restic forget --prune), with a server-authoritative environment access gate",
      "PathParameters": [
        {
          "Name": "id",
          "Argument": "id",
          "Type": {
            "Type": "String"
          }

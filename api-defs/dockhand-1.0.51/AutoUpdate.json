      "OperationId": "get_api_auto-update",
      "Method": "GET",
      "Path": "/api/auto-update",
      "Description": "Get all enabled auto-update settings for an environment, keyed by container name",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Environment ID to read settings for (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Dictionary",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "GetAutoUpdateAnswer"
          }
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

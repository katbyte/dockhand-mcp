{
  "Name": "AutoUpdate",
  "Tag": "auto-update",
  "Operations": [
    {
      "Name": "DeleteAutoUpdateByContainerName",
      "OperationId": "delete_api_auto-update_containerName",
      "Method": "DELETE",
      "Path": "/api/auto-update/{containerName}",
      "Description": "Delete a container's auto-update setting and unregister its schedule",
      "PathParameters": [
        {
          "Name": "containerName",
          "Argument": "containerName",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "Environment the container belongs to (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteAutoUpdateByContainerNameAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {

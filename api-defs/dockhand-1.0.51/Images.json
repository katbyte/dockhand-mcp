    {
      "Name": "GetImagesScan",
      "OperationId": "get_api_images_scan",
      "Method": "GET",
      "Path": "/api/images/scan",
      "Description": "Return the latest cached vulnerability scan for an image, resolving its tag to a SHA256 ID",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment the image belongs to (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "image",
          "Field": "Image",
          "In": "Query",
          "Description": "Image name or ID to look up cached results for",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "scanner",
          "Field": "Scanner",
          "In": "Query",
          "Description": "Restrict the lookup to a specific scanner (e.g. grype or trivy)",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetImagesScanResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetImagesScanExport",
      "OperationId": "get_api_images_scan_export",
      "Method": "GET",
      "Path": "/api/images/scan/export",
      "Description": "Export the cached vulnerability findings for a single image as json, csv, or sarif",
      "Options": [
        {
          "Name": "imageId",
          "Field": "ImageId",
          "In": "Query",
          "Description": "Image SHA/ID to export (falls back to the \"image\" param when omitted) (from GET /api/images)",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "image",
          "Field": "Image",
          "In": "Query",
          "Description": "Image name/ID used as a fallback when imageId is not given",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "format",
          "Field": "Format",
          "In": "Query",
          "Description": "Output format — json (default), csv, or sarif",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "the environment the image is on",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/octet-stream",
        "Type": {
          "Type": "RawFile"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

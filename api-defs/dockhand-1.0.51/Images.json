{
  "Name": "Images",
  "Tag": "images",
  "Operations": [
    {
      "Name": "DeleteImagesById",
      "OperationId": "delete_api_images_id",
      "Method": "DELETE",
      "Path": "/api/images/{id}",
      "Description": "Remove a Docker image by ID or name (optionally forced), scoped to an environment",
      "PathParameters": [
        {
          "Name": "id",
          "Argument": "id",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment the image belongs to (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "force",
          "Field": "Force",
          "In": "Query",
          "Description": "Force removal even if the image is tagged or referenced (default false)",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteImagesByIdResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetImages",
      "OperationId": "get_api_images",
      "Method": "GET",
      "Path": "/api/images",
      "Description": "List the Docker images of an environment (returns an empty array when no env is given or Docker is unreachable)",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment whose images to list (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "GetImagesResponse"
          }
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetImagesByIdExport",
      "OperationId": "get_api_images_id_export",
      "Method": "GET",
      "Path": "/api/images/{id}/export",
      "Description": "Export a Docker image as a downloadable tar (or tar.gz) stream",
      "PathParameters": [
        {
          "Name": "id",
          "Argument": "id",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment the image belongs to (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "tag",
          "Field": "Tag",
          "In": "Query",
          "Description": "Which of the image's tags to name the download after (defaults to its first tag)",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "compress",
          "Field": "Compress",
          "In": "Query",
          "Description": "Gzip the tar stream and serve it as .tar.gz (default false)",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "Response": {
        "ContentType": "application/x-tar",
        "Type": {
          "Type": "RawFile"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

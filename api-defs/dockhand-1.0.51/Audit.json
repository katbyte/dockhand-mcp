            "Type": "String"
          }
        },
        {
          "Name": "environmentId",
          "Field": "EnvironmentId",
          "In": "Query",
          "Description": "Filter to a single environment (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "labels",
          "Field": "Labels",
          "In": "Query",
          "Description": "Comma-separated labels to filter by",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "fromDate",
          "Field": "FromDate",
          "In": "Query",
          "Description": "Start of the date range (ISO 8601)",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "toDate",
          "Field": "ToDate",
          "In": "Query",
          "Description": "End of the date range (ISO 8601)",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "limit",
          "Field": "Limit",
          "In": "Query",
          "Description": "Maximum number of entries to return",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "offset",
          "Field": "Offset",
          "In": "Query",
          "Description": "Number of entries to skip (pagination)",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetAuditResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

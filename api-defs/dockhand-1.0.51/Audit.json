          "Description": "Comma-separated actions to filter by",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "username",
          "Field": "Username",
          "In": "Query",
          "Description": "Legacy single-username filter",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "entityType",
          "Field": "EntityType",
          "In": "Query",
          "Description": "Legacy single entity-type filter",
          "Type": {
            "Type": "String"
          }
        },
        {

        {
          "Name": "id",
          "Field": "Id",
          "In": "Query",
          "Description": "ID of the template source to delete (from GET /api/templates/sources)",
          "Required": true,
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteTemplatesSourcesAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

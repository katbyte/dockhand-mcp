    {
      "Name": "PostVulnerabilitiesScanAll",
      "OperationId": "post_api_vulnerabilities_scan-all",
      "Method": "POST",
      "Path": "/api/vulnerabilities/scan-all",
      "Description": "Scan every image in an environment for vulnerabilities, streaming per-image progress as Server-Sent Events",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment whose images to scan (from GET /api/environments)",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        },
        {
          "Name": "Accept",
          "Field": "Accept",
          "In": "Header",
          "Description": "what the caller will take for an answer. Left out, the call waits for the work and answers how it went; AcceptJob has it answered with the id of a job at once",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostVulnerabilitiesScanAllAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }

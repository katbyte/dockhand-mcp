{
  "Name": "Vulnerabilities",
  "Tag": "vulnerabilities",
  "Operations": [
    {
      "Name": "GetVulnerabilities",
      "OperationId": "get_api_vulnerabilities",
      "Method": "GET",
      "Path": "/api/vulnerabilities",
      "Description": "A filtered, sorted page of aggregated vulnerability findings for an environment",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "the environment whose findings are asked for: with none, nothing is found",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        },
        {
          "Name": "q",
          "Field": "Q",
          "In": "Query",
          "Description": "only findings whose CVE, package, image, container or stack holds this text, whatever its case",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "severity",
          "Field": "Severity",
          "In": "Query",
          "Description": "only findings this grave: critical, high, medium or low, or several with commas between",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "image",
          "Field": "Image",
          "In": "Query",
          "Description": "only findings of the image by this name, whole, or of several with commas between",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "container",
          "Field": "Container",
          "In": "Query",
          "Description": "only findings of the image a container by this name was made from",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "stack",
          "Field": "Stack",
          "In": "Query",
          "Description": "only findings of the images a stack's containers were made from",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "sort",
          "Field": "Sort",
          "In": "Query",
          "Description": "what to order by: severity, cve, package, image, installed, fixed, container, stack or scannedAt",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "dir",
          "Field": "Dir",
          "In": "Query",
          "Description": "desc for the order turned round; by severity the gravest come first unless it is",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "limit",
          "Field": "Limit",
          "In": "Query",
          "Description": "the most findings to answer; every one unless given, and 0 for the counts alone",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "offset",
          "Field": "Offset",
          "In": "Query",
          "Description": "how many findings to pass over first",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetVulnerabilitiesAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetVulnerabilitiesCount",
      "OperationId": "get_api_vulnerabilities_count",
      "Method": "GET",
      "Path": "/api/vulnerabilities/count",
      "Description": "Return the total finding count, severity summary, and distinct image/container/stack filter values for an environment",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "the environment whose findings are asked for: with none, nothing is found",
          "Type": {
            "Type": "ID",
            "ReferenceName": "EnvironmentID"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetVulnerabilitiesCountAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

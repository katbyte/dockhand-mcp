{
  "Name": "Users",
  "Tag": "users",
  "Operations": [
    {
      "Name": "DeleteUsersById",
      "OperationId": "delete_api_users_id",
      "Method": "DELETE",
      "Path": "/api/users/{id}",
      "Description": "Delete a user by id; deleting the last admin while auth is enabled disables authentication and requires confirmDisableAuth",
      "PathParameters": [
        {
          "Name": "id",
          "Argument": "id",
          "Type": {
            "Type": "ID",
            "ReferenceName": "UserID"
          }
        }
      ],
      "Options": [
        {
          "Name": "confirmDisableAuth",
          "Field": "ConfirmDisableAuth",
          "In": "Query",
          "Description": "Set to true to confirm deleting the last admin (which disables authentication)",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteUsersByIdAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },

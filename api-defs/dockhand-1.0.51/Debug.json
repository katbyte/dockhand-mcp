  "Operations": [
    {
      "Name": "GetDebugMemory",
      "OperationId": "get_api_debug_memory",
      "Method": "GET",
      "Path": "/api/debug/memory",
      "Description": "Return Node.js/V8 memory diagnostics; only enabled when MEMORY_MONITOR=true. Also supports ?snapshot and ?snapshots to dump/list heap snapshots.",
      "Options": [
        {
          "Name": "gc",
          "Field": "Gc",
          "In": "Query",
          "Description": "Force garbage collection before reporting when true (requires Node started with --expose-gc)",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetDebugMemoryAnswer"
        }
      },

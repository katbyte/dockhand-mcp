{
  "Name": "Profile",
  "Tag": "profile",
  "Operations": [
    {
      "Name": "DeleteProfileAvatar",
      "OperationId": "delete_api_profile_avatar",
      "Method": "DELETE",
      "Path": "/api/profile/avatar",
      "Description": "Remove the authenticated user's avatar",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteProfileAvatarAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetProfile",
      "OperationId": "get_api_profile",
      "Method": "GET",
      "Path": "/api/profile",
      "Description": "Get the authenticated user's own profile",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetProfileAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetProfilePreferences",
      "OperationId": "get_api_profile_preferences",
      "Method": "GET",
      "Path": "/api/profile/preferences",
      "Description": "Get the current user's UI preferences (theme, fonts, editor options)",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "RawObject"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostProfileAvatar",
      "OperationId": "post_api_profile_avatar",
      "Method": "POST",
      "Path": "/api/profile/avatar",
      "Description": "Upload the authenticated user's avatar as a base64 image data URL (max ~500KB)",
      "Request": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostProfileAvatarRequest"
        }
      },
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostProfileAvatarAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PutProfile",
      "OperationId": "put_api_profile",
      "Method": "PUT",
      "Path": "/api/profile",
      "Description": "Update the authenticated user's own profile (email/display name, and optionally the password with current-password confirmation)",
      "Request": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PutProfileRequest"
        }
      },
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PutProfileAnswer"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PutProfilePreferences",
      "OperationId": "put_api_profile_preferences",
      "Method": "PUT",
      "Path": "/api/profile/preferences",
      "Description": "Update the current user's UI preferences (each field is optional)",
      "Request": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PutProfilePreferencesRequest"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],

{
  "Name": "System",
  "Tag": "system",
  "Operations": [
    {
      "Name": "GetSystem",
      "OperationId": "get_api_system",
      "Method": "GET",
      "Path": "/api/system",
      "Description": "Return aggregated system info — Docker daemon, host, Node.js runtime, database, and object counts for an environment",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment to collect Docker info for (Docker fields are null when omitted or unreachable) (from GET /api/environments)",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetSystemResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetSystemDisk",
      "OperationId": "get_api_system_disk",
      "Method": "GET",
      "Path": "/api/system/disk",
      "Description": "Return Docker disk usage (df) for an environment, or null when collection is disabled, times out, or fails",
      "Options": [
        {
          "Name": "env",
          "Field": "Env",
          "In": "Query",
          "Description": "ID of the environment to query disk usage for (from GET /api/environments)",
          "Required": true,
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetSystemDiskResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetSystemFiles",
      "OperationId": "get_api_system_files",
      "Method": "GET",
      "Path": "/api/system/files",
      "Description": "List the entries of a directory on Dockhand's local filesystem (protected paths are hidden)",
      "Options": [
        {
          "Name": "path",
          "Field": "Path",
          "In": "Query",
          "Description": "Absolute directory path to list (defaults to \"/\")",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetSystemFilesResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetSystemFilesContent",
      "OperationId": "get_api_system_files_content",
      "Method": "GET",
      "Path": "/api/system/files/content",
      "Description": "Read a text file from Dockhand's local filesystem (max 10MB, protected paths denied)",
      "Options": [
        {
          "Name": "path",
          "Field": "Path",
          "In": "Query",
          "Description": "Absolute path of the file to read",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetSystemFilesContentResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostSystemFiles",
      "OperationId": "post_api_system_files",
      "Method": "POST",
      "Path": "/api/system/files",
      "Description": "Create a directory on Dockhand's local filesystem (absolute path, no traversal, non-protected)",
      "Request": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostSystemFilesRequest"
        }
      },
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostSystemFilesResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],

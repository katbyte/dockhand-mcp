{
  "Name": "Dashboard",
  "Tag": "dashboard",
  "Operations": [
    {
      "Name": "GetDashboardPreferences",
      "OperationId": "get_api_dashboard_preferences",
      "Method": "GET",
      "Path": "/api/dashboard/preferences",
      "Description": "Get the current user's dashboard preferences (grid layout, lock state, view mode)",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetDashboardPreferencesResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetDashboardStats",
      "OperationId": "get_api_dashboard_stats",
      "Method": "GET",
      "Path": "/api/dashboard/stats",
      "Description": "Get aggregated dashboard statistics per environment (containers, images, volumes, stacks, metrics)",
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "GetDashboardStatsResponse"
          }
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetDashboardStatsStream",
      "OperationId": "get_api_dashboard_stats_stream",
      "Method": "GET",
      "Path": "/api/dashboard/stats/stream",
      "Description": "Stream per-environment dashboard stats progressively over Server-Sent Events",
      "Response": {
        "ContentType": "text/event-stream",
        "Type": {
          "Type": "RawFile"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "PostDashboardPreferences",
      "OperationId": "post_api_dashboard_preferences",
      "Method": "POST",
      "Path": "/api/dashboard/preferences",
      "Description": "Update the current user's dashboard preferences (only provided fields are merged)",
      "Request": {

        }
      },
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PostDashboardPreferencesResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }

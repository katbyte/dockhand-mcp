{
  "Name": "Registry",
  "Tag": "registry",
  "Operations": [
    {
      "Name": "DeleteRegistryImage",
      "OperationId": "delete_api_registry_image",
      "Method": "DELETE",
      "Path": "/api/registry/image",
      "Description": "Delete a tagged image from a registry by resolving its manifest digest, then deleting by digest",
      "Options": [
        {
          "Name": "registry",
          "Field": "Registry",
          "In": "Query",
          "Description": "ID of the configured registry (from GET /api/registries)",
          "Required": true,
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "image",
          "Field": "Image",
          "In": "Query",
          "Description": "Repository/image name (may include an org path)",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "tag",
          "Field": "Tag",
          "In": "Query",
          "Description": "Tag to delete",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "DeleteRegistryImageResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetRegistryCatalog",
      "OperationId": "get_api_registry_catalog",
      "Method": "GET",
      "Path": "/api/registry/catalog",
      "Description": "List repositories in a registry's V2 catalog (with Harbor project-API fallback), paginated",
      "Options": [
        {
          "Name": "registry",
          "Field": "Registry",
          "In": "Query",
          "Description": "ID of the configured registry to query (from GET /api/registries)",
          "Required": true,
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "last",
          "Field": "Last",
          "In": "Query",
          "Description": "Opaque pagination cursor from a previous page's nextLast",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetRegistryCatalogResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetRegistrySearch",
      "OperationId": "get_api_registry_search",
      "Method": "GET",
      "Path": "/api/registry/search",
      "Description": "Search for images by name in Docker Hub or a configured private registry (direct + catalog fallback)",
      "Options": [
        {
          "Name": "term",
          "Field": "Term",
          "In": "Query",
          "Description": "Search term / image name",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "limit",
          "Field": "Limit",
          "In": "Query",
          "Description": "Maximum number of results (default 25)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "registry",
          "Field": "Registry",
          "In": "Query",
          "Description": "ID of the configured registry to search; omit to search Docker Hub (from GET /api/registries)",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "GetRegistrySearchResponse"
          }
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetRegistryTagInfo",
      "OperationId": "get_api_registry_tag-info",
      "Method": "GET",
      "Path": "/api/registry/tag-info",
      "Description": "Resolve the compressed size and creation date of a single registry tag from its manifest (lazy per-tag fetch for the registry browser)",
      "Options": [
        {
          "Name": "registry",
          "Field": "Registry",
          "In": "Query",
          "Description": "Registry ID; omitted or Docker Hub registries return a graceful \"not supported\" result instead of a manifest fetch (from GET /api/registries)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "image",
          "Field": "Image",
          "In": "Query",
          "Description": "Image repository/name",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "tag",
          "Field": "Tag",
          "In": "Query",
          "Description": "Tag name or digest",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetRegistryTagInfoResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetRegistryTags",
      "OperationId": "get_api_registry_tags",

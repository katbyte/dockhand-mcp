        {
          "Name": "image",
          "Field": "Image",
          "In": "Query",
          "Description": "Repository/image name",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "page",
          "Field": "Page",
          "In": "Query",
          "Description": "Page number for Docker Hub pagination (default 1)",
          "Type": {
            "Type": "Integer"
          }
        },
        {
          "Name": "pageSize",
          "Field": "PageSize",
          "In": "Query",
          "Description": "Page size for Docker Hub pagination (default 20)",
          "Type": {
            "Type": "Integer"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "GetRegistryTagsResponse"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],
